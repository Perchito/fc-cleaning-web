{
  "rewrites": [
    { "source": "/ops", "destination": "/ops/index.html" },
    { "source": "/ops/((?!assets/).*)", "destination": "/ops/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/outreach/cron", "schedule": "0 8 * * *" },
    { "path": "/api/outreach/discover", "schedule": "0 8 * * *" }
  ],
  "functions": {
    "api/outreach/cron.js": { "maxDuration": 300 },
    "api/outreach/discover.js": { "maxDuration": 300 },
    "api/outreach/enrich.js": { "maxDuration": 120 },
    "api/outreach/migrate.js": { "maxDuration": 120 },
    "api/outreach/*.js": { "maxDuration": 60 }
  }
}
