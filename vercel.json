{
  "rewrites": [
    { "source": "/ops", "destination": "/ops/index.html" },
    { "source": "/ops/((?!assets/).*)", "destination": "/ops/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/outreach/[[...path]].js": { "maxDuration": 300 }
  }
}
