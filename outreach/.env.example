# Copy to ".env" and fill in. This file holds NO secrets — the iCloud
# password is read at runtime from the icloud-email MCP server's own .env
# (~/.claude/mcp-servers/icloud-email/.env), so there is only one copy.

# Long random string required to open the dashboard (?token=... then cookie).
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DASHBOARD_TOKEN=

# Port the dashboard listens on.
PORT=4517

# Where the daily digest email goes. Defaults to your iCloud login address.
DIGEST_TO=

# When the daily reply-check runs (cron, local time). Default 08:00 daily.
POLL_CRON=0 8 * * *

# Follow-up defaults for new prospects.
FOLLOWUP_INTERVAL_DAYS=5
MAX_FOLLOWUPS=2

# Compliance footer / identity (used in drafted emails).
REPLY_TO=fernando.c@fccleaningcompany.com
POSTAL_ADDRESS=57 St Davids Crescent, Aspull, Wigan WN2 1SZ
PHONE=07473 379928
WEBSITE=fccleaningcompany.com
SENDER_FIRST_NAME=Fernando

# Override only if the MCP server's .env lives somewhere non-standard.
# ICLOUD_ENV_PATH=/Users/you/.claude/mcp-servers/icloud-email/.env
